// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table maritimeAIS (IngestionTime:datetime, MMSI:int, ShipName:string, VesselType:string, Latitude:real, Longitude:real, SpeedKnots:real, HeadingDegrees:real, TransmittedUtc:string) 
.create-or-alter table maritimeAIS ingestion json mapping 'maritimeEH2_mapping'
```
[{"Properties":{"Path":"$['IngestionTime']"},"column":"IngestionTime","datatype":""},{"Properties":{"Path":"$['MMSI']"},"column":"MMSI","datatype":""},{"Properties":{"Path":"$['ShipName']"},"column":"ShipName","datatype":""},{"Properties":{"Path":"$['VesselType']"},"column":"VesselType","datatype":""},{"Properties":{"Path":"$['Latitude']"},"column":"Latitude","datatype":""},{"Properties":{"Path":"$['Longitude']"},"column":"Longitude","datatype":""},{"Properties":{"Path":"$['SpeedKnots']"},"column":"SpeedKnots","datatype":""},{"Properties":{"Path":"$['HeadingDegrees']"},"column":"HeadingDegrees","datatype":""},{"Properties":{"Path":"$['TransmittedUtc']"},"column":"TransmittedUtc","datatype":""}]
```
.create-or-alter table maritimeAIS ingestion json mapping 'maritimeAIS_mapping'
